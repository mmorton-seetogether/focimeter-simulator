{
  "name": "focimeter-simulator",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "An interactive focimeter (lensmeter) trainer for optometry and dispensing students.",
  "license": "MIT",
  "scripts": {
    "predev": "node scripts/generate-og-image.mjs",
    "dev": "vite",
    "prebuild": "node scripts/generate-og-image.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "og-image": "node scripts/generate-og-image.mjs",
    "screenshot": "node scripts/screenshot.mjs"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "optometry",
    "focimeter",
    "lensmeter",
    "optics",
    "education",
    "simulator"
  ]
}
